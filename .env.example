SECRET_KEY=change-me
# Option 1: full URL
# DATABASE_URL=postgresql+psycopg2://crm_app:StrongPassword@localhost:5432/ambifo_crm?sslmode=prefer

# Option 2: authenticated PostgreSQL parts (used when DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ambifo_crm
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=StrongPassword
POSTGRES_SSLMODE=prefer

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
MAIL_FROM=crm@ambifo.com
APP_BASE_URL=http://127.0.0.1:5000
UPLOAD_FOLDER=uploads

# Microsoft Teams auto meeting-link generation via Graph
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_ID=
TEAMS_DEFAULT_DURATION_MINUTES=60

# Default admin login created on flask init-db
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
